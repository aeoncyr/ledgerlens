# Copy this file to .env and fill in your own values. Never commit .env.
# Firestore and Cloud Storage use Google credentials, not keys: locally, run
#   gcloud auth application-default login
# and on Cloud Run the service runs as its own service account.

# --- Backend (api/) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# No Gemini model is served in the Jakarta region, so Gemini calls use the global endpoint.
GOOGLE_CLOUD_LOCATION=global
# Gemini: set a Google AI Studio key to use the Gemini Developer API (the prototype uses its free
# tier). Leave it empty to use Vertex AI through your Google credentials instead (paid).
GEMINI_API_KEY=
GOOGLE_GENAI_USE_ENTERPRISE=true
# Model chains, tried in order (comma-separated). With a key they default to the free tier's
# Flash-Lite models for the readers and four Flash models for the verifier and memo writer, since
# each model has its own daily quota. On Vertex AI both default to MODEL_MAIN, then MODEL_FALLBACK.
READER_MODELS=
WRITER_MODELS=
MODEL_MAIN=gemini-3.8-flash
MODEL_FALLBACK=gemini-3.5-flash
# How hard the writers think: minimal, low, medium or high (default low with a key).
WRITER_THINKING=
# Calls in flight at once (default 4 with a key, 8 on Vertex AI), and whether each notebook page
# is read twice to catch misreadings.
MAX_PARALLEL_CALLS=
LEDGER_DOUBLE_READ=true
# Optional: set to gemini-4-argon to try the stronger model for the verifier and memo writer.
MODEL_STRONG=
STORAGE_BUCKET=your-project.firebasestorage.app
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=10

# --- Web app (web/) ---
# The Firebase web config is not secret, but it lives here so each environment can use its own project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
