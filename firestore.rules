rules_version = '2';

// Browsers only read. Every write goes through the API, which uses the Admin SDK and is not bound by
// these rules, so results can't be tampered with from the client.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function application(appId) {
      return get(/databases/$(database)/documents/applications/$(appId)).data;
    }

    // The lender's officer on this file.
    function isOfficer(appId) {
      return signedIn() && application(appId).get('officerUid', null) == request.auth.uid;
    }

    // The business owner who started this file.
    function isOwner(appId) {
      return signedIn() && application(appId).get('ownerUid', null) == request.auth.uid;
    }

    match /applications/{appId} {
      allow read: if signedIn()
        && (resource.data.get('officerUid', null) == request.auth.uid
          || resource.data.get('ownerUid', null) == request.auth.uid);

      // The owner sees their evidence, the progress of a check, and the summary written for them.
      match /evidence/{doc} {
        allow read: if isOfficer(appId) || isOwner(appId);
      }
      match /runs/{doc} {
        allow read: if isOfficer(appId) || isOwner(appId);
      }
      match /owner/{doc} {
        allow read: if isOfficer(appId) || isOwner(appId);
      }

      // The credit memo, findings and audit log are the lender's.
      match /{child=**} {
        allow read: if isOfficer(appId);
      }
    }

    match /pageReadings/{readingId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /receiptReadings/{readingId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // The fictional sample businesses on the landing page are public.
    match /samples/{document=**} {
      allow read: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
