rules_version = '2';

// Evidence photos and recordings live under evidence/{applicationId}/{uid}/. Each signed-in user may
// upload into and read only their own folder; the API registers a file only if the application is
// theirs and the path is under their folder. Uploads must be images or audio under 15 MB, and
// nothing can be overwritten or deleted from the browser.
service firebase.storage {
  match /b/{bucket}/o {
    match /evidence/{appId}/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('(image|audio)/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
